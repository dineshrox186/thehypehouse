{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["bom1"],
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "functions": { "api/**/*.js": { "maxDuration": 30, "includeFiles": "dist/**" } },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1/router?__hypehouse_path=:path*" }
  ],
  "crons": [{ "path": "/api/v1/internal/outbox", "schedule": "0 6 * * *" }]
}