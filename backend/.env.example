# Hype House API configuration — never expose these values to the browser.
NODE_ENV=development
REPO=memory
PORT=8787
CORS_ORIGIN=https://thehypehouse.vercel.app
SECURE_COOKIES=0
TRUST_PROXY=0
COOKIE_SAME_SITE=Lax

# Dedicated Hype House Supabase project only. Do not use Vertex database credentials.
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_SSL=require
PG_POOL_MAX=3

TURNSTILE_SECRET=
RESEND_API_KEY=
MAIL_FROM=The Hype House <hello@your-verified-domain>
EVENT_TIMEZONE=Asia/Kolkata
CRON_SECRET=

# Development only
SEED=0
SEED_PASSWORD=
